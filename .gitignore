# Secrets / auth tokens
gh/.config/gh/hosts.yml
raycast/.config/raycast/config.json

# Per-machine local overrides (see zsh/.config/zsh/.zshrc)
zsh/.config/zsh/.env.local

# zsh runtime/cache files (not config)
zsh/.config/zsh/.zcompdump*
zsh/.config/zsh/.zsh_history
zsh/.config/zsh/.zsh_sessions/

# Runtime installs (not config)
raycast/.config/raycast/extensions/

# catppuccin/tmux is manually cloned, not TPM-managed or vendored (see
# bootstrap/catppuccin-tmux.md)
tmux/.config/tmux/plugins/

# MPD runtime files (not config)
mpd/.config/mpd/database
mpd/.config/mpd/log
mpd/.config/mpd/pid
mpd/.config/mpd/state
mpd/.config/mpd/sticker.sql

# macOS
.DS_Store
