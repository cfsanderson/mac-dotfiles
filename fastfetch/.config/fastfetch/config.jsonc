{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "position": "top",
    "color": {
      "1": "default"
    }
  },
  "modules": [
    "colors",
    "break",
    "os",
    "host",
    "uptime",
    "shell",
    "display",
    "de",
    "icons",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "poweradapter",
  ]
}
